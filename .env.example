OPENAI_API_KEY=your_openai_api_key_here

# Local / Docker — ChromaDB (default when PINECONE_API_KEY is not set)
CHROMA_DB_PATH=./data/chroma_db
RAW_DATA_DIR=./data/raw/Yelp-JSON/Yelp JSON/yelp_dataset
PROCESSED_DATA_DIR=./data/processed
LOG_LEVEL=INFO

# Cloud / Render — Pinecone (set these to switch backend automatically)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=bct-hackathon
